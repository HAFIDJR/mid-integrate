# ---------------------------------------------------------------------------
# Kasir Digital — server environment template
# Copy to `.env` (git-ignored) and fill in your own Midtrans Sandbox keys.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# Midtrans Server Key — server only. It is never sent to the browser.
# Sandbox: Dashboard → Settings → Access Keys
MIDTRANS_SERVER_KEY=

# false = sandbox (api.sandbox.midtrans.com), true = production (api.midtrans.com)
MIDTRANS_IS_PRODUCTION=false

# Optional: QR validity requested from Midtrans (minutes, default 15).
MIDTRANS_QRIS_EXPIRY_MINUTES=15

# Optional: QRIS acquirer. Leave empty for Midtrans's default (gopay).
# Allowed: gopay | airpay shopee (the literal value, with the space).
# If GoPay-acquired QRs fail in the sandbox simulator with "merchant not found",
# switch to: MIDTRANS_QRIS_ACQUIRER=airpay shopee
MIDTRANS_QRIS_ACQUIRER=

# Dev only: enables POST /api/payments/:orderId/simulate, which settles a QRIS
# order locally instead of paying it in the Midtrans sandbox simulator.
# Always ignored when MIDTRANS_IS_PRODUCTION=true. Leave off in production.
MIDTRANS_DEV_SIMULATE=0

# Optional: outbound Midtrans request timeout in milliseconds (default 12000).
MIDTRANS_TIMEOUT_MS=12000

# API server
PORT=3001
HOST=0.0.0.0

# Durable order metadata file (relative to the working directory is fine).
ORDER_STORE_PATH=.data/orders.json

# Built frontend served by the production server.
STATIC_DIR=dist
